    { value: '3x4-detail',    label: '3:4 Detail — 36stp / CFG 5.5 / 896×1152',         steps: 36, guidance: 5.5, width: 896,  height: 1152 },
    { value: '2x3-portrait',  label: '2:3 Portrait — 36stp / CFG 5.5 / 832×1216',       steps: 36, guidance: 5.5, width: 832,  height: 1216 },
