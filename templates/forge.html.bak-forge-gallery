{% extends "base.html" %}

{% block title %}Forge{% endblock %}

{% block content %}
<div class="container" style="padding-top: var(--spacing-xl); padding-bottom: var(--spacing-xl);">

  <!-- Header -->
  <div style="margin-bottom: var(--spacing-xl);">
    <h1 style="font-family: var(--font-display); font-size: 1.8rem; letter-spacing: 0.15em; color: var(--reach-cyan); text-shadow: 0 0 12px rgba(34,211,238,0.4); margin: 0 0 4px 0;">FORGE</h1>
    <p style="font-family: var(--font-mono); font-size: 0.65rem; color: rgba(34,211,238,0.4); letter-spacing: 0.2em; margin: 0;">// IMAGE SYNTHESIS — RUNPOD MULTI-MODEL SERVERLESS</p>
  </div>

  <!-- Generation Panel -->
  <div class="terminal-panel" style="margin-bottom: var(--spacing-xl); padding: var(--spacing-lg);">

    {% if not endpoint_configured %}
    <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--reach-orange); letter-spacing: 0.1em; padding: var(--spacing-md); border: 1px solid rgba(234,88,12,0.3); background: rgba(234,88,12,0.05); margin-bottom: var(--spacing-md);">
      ⚠ ENDPOINT NOT CONFIGURED — Set RUNPOD_API_KEY and at least one Forge endpoint secret in Doppler.
    </div>
    {% endif %}

    <!-- Prompt -->
    <div style="margin-bottom: var(--spacing-md);">
      <label style="font-family: var(--font-mono); font-size: 0.65rem; color: rgba(34,211,238,0.6); letter-spacing: 0.15em; display: block; margin-bottom: 6px;">PROMPT</label>
      <textarea
        id="forge-prompt"
        rows="3"
        maxlength="500"
        placeholder="Describe the image..."
        {% if not endpoint_configured %}disabled{% endif %}
        style="width: 100%; background: rgba(0,0,0,0.4); border: 1px solid rgba(34,211,238,0.2); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.8rem; padding: 10px 12px; resize: vertical; outline: none; box-sizing: border-box;"
      ></textarea>
      <div style="font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.3); text-align: right; margin-top: 3px;"><span id="prompt-count">0</span>/500</div>
    </div>

    <!-- Negative Prompt -->
    <details style="margin-bottom: var(--spacing-md);">
      <summary style="font-family: var(--font-mono); font-size: 0.65rem; color: rgba(34,211,238,0.4); letter-spacing: 0.1em; cursor: pointer; user-select: none;">NEGATIVE PROMPT (optional)</summary>
      <textarea
        id="forge-negative"
        rows="2"
        maxlength="500"
        placeholder="Things to exclude from the image..."
        {% if not endpoint_configured %}disabled{% endif %}
        style="width: 100%; margin-top: 8px; background: rgba(0,0,0,0.4); border: 1px solid rgba(34,211,238,0.15); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.8rem; padding: 10px 12px; resize: vertical; outline: none; box-sizing: border-box;"
      ></textarea>
    </details>

    <!-- Generation Parameters -->
    <details id="params-details" open style="margin-bottom: var(--spacing-md);">
      <summary style="font-family: var(--font-mono); font-size: 0.65rem; color: rgba(34,211,238,0.4); letter-spacing: 0.1em; cursor: pointer; user-select: none; margin-bottom: 12px;">GENERATION PARAMETERS</summary>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-top: 12px;">

        <!-- Compute Backend -->
        <div>
          <label style="font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.5); letter-spacing: 0.12em; display: block; margin-bottom: 4px;">COMPUTE BACKEND</label>
          <div style="font-family: var(--font-mono); font-size: 0.55rem; color: rgba(34,211,238,0.3); margin-bottom: 6px;">GPU endpoint for generation.</div>
          <select id="forge-backend"
            style="width: 100%; background: rgba(0,0,0,0.4); border: 1px solid rgba(34,211,238,0.2); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; padding: 7px 10px; outline: none; cursor: pointer;">
            <option value="forge" {% if has_forge %}selected{% endif %}>Forge Models</option>
            <option value="video" {% if not has_forge and has_wan %}selected{% endif %} {% if not has_wan %}disabled{% endif %}>WAN 2.2 Video</option>
            <option value="sdxl" {% if not has_forge and not has_wan %}selected{% endif %}>Legacy SDXL</option>
          </select>
        </div>

        <!-- Model -->
        <div>
          <label style="font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.5); letter-spacing: 0.12em; display: block; margin-bottom: 4px;">MODEL</label>
          <div style="font-family: var(--font-mono); font-size: 0.55rem; color: rgba(34,211,238,0.3); margin-bottom: 6px;">Base model for generation.</div>
          <select id="forge-model"
            style="width: 100%; background: rgba(0,0,0,0.4); border: 1px solid rgba(34,211,238,0.2); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; padding: 7px 10px; outline: none; cursor: pointer;">
            <option value="juggernaut-xl" {% if available_models.get('juggernaut-xl') %}selected{% endif %} {% if not available_models.get('juggernaut-xl') %}disabled{% endif %}>Juggernaut XL</option>
            <option value="cyberrealistic-pony" {% if not available_models.get('juggernaut-xl') and available_models.get('cyberrealistic-pony') %}selected{% endif %} {% if not available_models.get('cyberrealistic-pony') %}disabled{% endif %}>CyberRealistic Pony</option>
            <option value="wan22-i2v" {% if not has_forge and has_wan %}selected{% endif %} {% if not has_wan %}disabled{% endif %}>WAN 2.2 Animate</option>
            <option value="sdxl" {% if not has_forge and not has_wan and available_models.get('sdxl') %}selected{% endif %} {% if not available_models.get('sdxl') %}disabled{% endif %}>SDXL 1.0</option>
          </select>
        </div>

        <!-- Preset Selector -->
        <div style="grid-column: 1 / -1;">
          <label style="font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.5); letter-spacing: 0.12em; display: block; margin-bottom: 4px;">PRESET</label>
          <div style="font-family: var(--font-mono); font-size: 0.55rem; color: rgba(34,211,238,0.3); margin-bottom: 6px;">Steps, CFG, and dimensions optimized per backend.</div>
          <select id="forge-preset"
            style="width: 100%; background: rgba(0,0,0,0.4); border: 1px solid rgba(34,211,238,0.2); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; padding: 7px 10px; outline: none; cursor: pointer;"
            onchange="applyPreset()">
          </select>
        </div>

        <!-- Hidden inputs for generation params -->
        <input type="hidden" id="forge-width" value="1024">
        <input type="hidden" id="forge-height" value="1024">
        <input type="hidden" id="forge-steps" value="28">
        <input type="hidden" id="forge-guidance" value="7">

        <div id="wan-reference-panel" style="grid-column: 1 / -1; display: none; border: 1px solid rgba(34,211,238,0.12); padding: 12px; background: rgba(0,0,0,0.2);">
          <label style="font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.5); letter-spacing: 0.12em; display: block; margin-bottom: 6px;">REFERENCE IMAGE</label>
          <div style="font-family: var(--font-mono); font-size: 0.55rem; color: rgba(34,211,238,0.3); margin-bottom: 10px;">Upload an image or use ANIMATE on a generated image below.</div>
          <div style="display: flex; gap: 12px; align-items: flex-start; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 240px;">
              <input type="file" id="wan-reference-upload" accept="image/png,image/jpeg,image/webp"
                style="width: 100%; background: rgba(0,0,0,0.4); border: 1px solid rgba(34,211,238,0.2); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; padding: 7px 10px; box-sizing: border-box;">
              <div style="display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;">
                <button id="wan-clear-reference-btn" type="button"
                  style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; padding: 7px 14px; background: transparent; border: 1px solid rgba(34,211,238,0.25); color: rgba(34,211,238,0.5); cursor: pointer;">CLEAR REF</button>
                <span id="wan-reference-label" style="font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.4); align-self: center;">NONE SELECTED</span>
              </div>
            </div>
            <div id="wan-reference-preview-shell" style="width: 120px; display: none;">
              <img id="wan-reference-preview" src="" alt="Reference preview" style="width: 120px; height: 120px; object-fit: cover; display: block; border: 1px solid rgba(34,211,238,0.2);">
            </div>
          </div>
          <input type="hidden" id="wan-reference-url" value="">
          <input type="hidden" id="wan-video-length" value="81">
          <input type="hidden" id="wan-context-overlap" value="48">
        </div>

        <!-- Seed (full width) -->
        <div style="grid-column: 1 / -1;">
          <label style="font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.5); letter-spacing: 0.12em; display: block; margin-bottom: 4px;">
            SEED <span style="color: rgba(34,211,238,0.3);">(-1 = random)</span>
          </label>
          <div style="font-family: var(--font-mono); font-size: 0.55rem; color: rgba(34,211,238,0.3); margin-bottom: 6px;">Locks the random noise — same seed + same prompt = same image every time.</div>
          <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <input type="number" id="forge-seed" value="-1" min="-1" max="4294967295"
              style="flex: 1; background: rgba(0,0,0,0.4); border: 1px solid rgba(34,211,238,0.2); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; padding: 7px 10px; outline: none; box-sizing: border-box;">
            <button id="random-seed-btn" type="button"
              style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; padding: 7px 14px; background: transparent; border: 1px solid rgba(34,211,238,0.25); color: rgba(34,211,238,0.5); cursor: pointer; white-space: nowrap;"
              onmouseover="this.style.borderColor='rgba(34,211,238,0.5)';this.style.color='var(--reach-cyan)'"
              onmouseout="this.style.borderColor='rgba(34,211,238,0.25)';this.style.color='rgba(34,211,238,0.5)'">
              RANDOM
            </button>
            <button id="clear-seed-btn" type="button"
              style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; padding: 7px 14px; background: transparent; border: 1px solid rgba(34,211,238,0.25); color: rgba(34,211,238,0.5); cursor: pointer; white-space: nowrap;"
              onmouseover="this.style.borderColor='rgba(34,211,238,0.5)';this.style.color='var(--reach-cyan)'"
              onmouseout="this.style.borderColor='rgba(34,211,238,0.25)';this.style.color='rgba(34,211,238,0.5)'">
              CLEAR
            </button>
          </div>
        </div>

        <div id="wan-lora-panel" style="grid-column: 1 / -1; display: none;">
          <label style="font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.5); letter-spacing: 0.12em; display: block; margin-bottom: 4px;">LORA PAIRS JSON (optional)</label>
          <textarea id="wan-lora-pairs" rows="5" placeholder='[{"high":"high.safetensors","low":"low.safetensors","high_weight":1.0,"low_weight":1.0}]'
            style="width: 100%; background: rgba(0,0,0,0.4); border: 1px solid rgba(34,211,238,0.15); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.75rem; padding: 10px 12px; resize: vertical; outline: none; box-sizing: border-box;"></textarea>
        </div>

      </div>
    </details>

    <details style="margin-bottom: var(--spacing-md);">
      <summary style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--reach-amber); letter-spacing: 0.1em; cursor: pointer; user-select: none;">OPTIMIZATION REFERENCE</summary>
      <div style="margin-top: 12px; border: 1px solid rgba(34,211,238,0.1); background: rgba(0,0,0,0.2); padding: 8px; overflow-x: auto; max-width: 100%; box-sizing: border-box;">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 0.6rem; color: rgba(34,211,238,0.7); min-width: 350px;">
          <thead>
            <tr style="border-bottom: 1px solid rgba(34,211,238,0.2); text-align: left;">
              <th style="padding: 6px; width: 96px;">MODEL</th>
              <th style="padding: 6px; width: 45px;">STEPS</th>
              <th style="padding: 6px; width: 40px;">CFG</th>
              <th style="padding: 6px; width: 85px;">RES</th>
              <th style="padding: 6px;">RESULT</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid rgba(34,211,238,0.05);">
              <td style="padding: 6px; color: var(--text-primary);">Juggernaut XL</td>
              <td style="padding: 6px;">28</td>
              <td style="padding: 6px;">7</td>
              <td style="padding: 6px;">1024x1024</td>
              <td style="padding: 6px; color: rgba(34,211,238,0.4); line-height: 1.2;">Lowest-cost balanced general preset.</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(34,211,238,0.05);">
              <td style="padding: 6px; color: var(--text-primary);">CyberReal Pony</td>
              <td style="padding: 6px;">30</td>
              <td style="padding: 6px;">5</td>
              <td style="padding: 6px;">896x1152</td>
              <td style="padding: 6px; color: rgba(34,211,238,0.4); line-height: 1.2;">Best starting point for portrait-heavy Pony generations.</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(34,211,238,0.1); background: rgba(34,211,238,0.05);">
              <td style="padding: 6px; color: var(--reach-cyan); font-weight: bold;">CyberReal Pony</td>
              <td style="padding: 6px; color: var(--reach-cyan);">36</td>
              <td style="padding: 6px; color: var(--reach-cyan);">5.5</td>
              <td style="padding: 6px; color: var(--reach-cyan);">832x1216</td>
              <td style="padding: 6px; color: var(--reach-cyan); line-height: 1.2;">Sharper portrait pass without pushing costs too far.</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(34,211,238,0.05);">
              <td style="padding: 6px; color: var(--text-primary);">Legacy SDXL</td>
              <td style="padding: 6px;">75</td>
              <td style="padding: 6px;">11.5</td>
              <td style="padding: 6px; color: var(--reach-cyan);">1024x1024</td>
              <td style="padding: 6px; color: rgba(34,211,238,0.4); line-height: 1.2;">Kept for the older high-step endpoint.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </details>

    <div style="display: flex; align-items: center; gap: var(--spacing-md);">
      <button
        id="forge-generate-btn"
        {% if not endpoint_configured %}disabled{% endif %}
        style="font-family: var(--font-display); font-size: 0.8rem; letter-spacing: 0.15em; padding: 10px 28px; background: transparent; border: 1px solid var(--reach-cyan); color: var(--reach-cyan); cursor: pointer; transition: all 0.2s;"
        onmouseover="if(!this.disabled)this.style.background='rgba(34,211,238,0.1)'"
        onmouseout="this.style.background='transparent'"
      >GENERATE</button>
      <span id="forge-status" style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--reach-amber); letter-spacing: 0.1em; display: none;"></span>
    </div>

    <div id="forge-error" style="display: none; margin-top: var(--spacing-sm); font-family: var(--font-mono); font-size: 0.7rem; color: var(--reach-orange); letter-spacing: 0.05em;"></div>
  </div>

  <!-- Gallery -->
  <div style="margin-bottom: var(--spacing-md);">
    <h2 style="font-family: var(--font-display); font-size: 1rem; letter-spacing: 0.15em; color: rgba(34,211,238,0.7); margin: 0 0 var(--spacing-md) 0;">GENERATED IMAGES</h2>
  </div>

  <div id="forge-gallery" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--spacing-md);">
    {% for img in images %}
    {% set model_label = img.model or img.worker_type or 'legacy' %}
    <div class="forge-card"
         data-id="{{ img.id }}"
         data-url="/static/forge_outputs/{{ img.filename }}"
         data-prompt="{{ img.prompt | e }}"
         data-model="{{ img.model or '' }}"
         data-worker="{{ img.worker_type or '' }}"
         data-negative="{{ (img.negative_prompt or '') | e }}"
         data-steps="{{ img.steps or '' }}"
         data-guidance="{{ img.guidance_scale or '' }}"
         data-width="{{ img.width or '' }}"
         data-height="{{ img.height or '' }}"
         data-seed="{{ img.seed if img.seed is not none else '' }}"
         data-created="{{ img.created_at[:16] }}"
         data-filename="{{ img.filename }}"
         style="background: rgba(21,25,42,0.85); border: 1px solid rgba(34,211,238,0.15); border-radius: 10px; overflow: hidden;">
      <div style="position: relative; cursor: zoom-in;" onclick="openLightbox('/static/forge_outputs/{{ img.filename }}')">
        <img src="/static/forge_outputs/{{ img.filename }}" alt="Generated image" loading="lazy"
             style="width: 100%; display: block; aspect-ratio: 1; object-fit: cover;">
        <span class="forge-model-badge">{{ model_label }}</span>
        <div class="forge-zoom-hint">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        </div>
      </div>
      <div style="padding: 10px 12px;">
        <p style="font-family: var(--font-mono); font-size: 0.65rem; color: rgba(34,211,238,0.5); margin: 0 0 8px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ img.prompt }}">{{ img.prompt }}</p>
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 6px;">
          <span style="font-family: var(--font-mono); font-size: 0.55rem; color: rgba(34,211,238,0.3); flex-shrink: 0;">{{ img.created_at[:16] }}</span>
          <div style="display: flex; gap: 6px; align-items: center;">
            <a href="/static/forge_outputs/{{ img.filename }}" download="{{ img.filename }}"
               style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; padding: 3px 10px; background: transparent; border: 1px solid rgba(34,211,238,0.3); color: rgba(34,211,238,0.6); cursor: pointer; text-decoration: none; display: inline-block;"
               onmouseover="this.style.background='rgba(34,211,238,0.08)';this.style.color='var(--reach-cyan)'"
               onmouseout="this.style.background='transparent';this.style.color='rgba(34,211,238,0.6)'">DL</a>
            {% if has_wan %}
            <button
              onclick="animateImage('/static/forge_outputs/{{ img.filename }}', '{{ img.prompt | e }}')"
              style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; padding: 3px 10px; background: transparent; border: 1px solid rgba(34,211,238,0.3); color: rgba(34,211,238,0.6); cursor: pointer;"
              onmouseover="this.style.background='rgba(34,211,238,0.08)'"
              onmouseout="this.style.background='transparent'"
            >ANIMATE</button>
            {% endif %}
            <button
              onclick="forgeDelete({{ img.id }}, this)"
              style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; padding: 3px 10px; background: transparent; border: 1px solid rgba(234,88,12,0.4); color: var(--reach-orange); cursor: pointer;"
              onmouseover="this.style.background='rgba(234,88,12,0.1)'"
              onmouseout="this.style.background='transparent'"
            >DEL</button>
          </div>
        </div>
      </div>
    </div>
    {% else %}
    <p id="forge-empty" style="font-family: var(--font-mono); font-size: 0.7rem; color: rgba(34,211,238,0.3); letter-spacing: 0.1em; grid-column: 1 / -1;">NO IMAGES GENERATED YET.</p>
    {% endfor %}
  </div>

  <div style="margin: var(--spacing-xl) 0 var(--spacing-md) 0;">
    <h2 style="font-family: var(--font-display); font-size: 1rem; letter-spacing: 0.15em; color: rgba(34,211,238,0.7); margin: 0 0 var(--spacing-md) 0;">GENERATED VIDEOS</h2>
  </div>

  <div id="forge-video-gallery" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--spacing-md);">
    {% for video in videos %}
    <div class="video-card" data-id="{{ video.id }}" style="background: rgba(21,25,42,0.85); border: 1px solid rgba(34,211,238,0.15); border-radius: 10px; overflow: hidden;">
      <video src="/static/forge_videos/{{ video.filename }}" controls preload="metadata" style="width: 100%; display: block; aspect-ratio: 16 / 9; background: #000;"></video>
      <div style="padding: 10px 12px;">
        <p style="font-family: var(--font-mono); font-size: 0.65rem; color: rgba(34,211,238,0.5); margin: 0 0 8px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ video.prompt }}">{{ video.prompt }}</p>
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 6px;">
          <span style="font-family: var(--font-mono); font-size: 0.55rem; color: rgba(34,211,238,0.3); flex-shrink: 0;">{{ video.created_at[:16] }}</span>
          <div style="display: flex; gap: 6px; align-items: center;">
            <a href="/static/forge_videos/{{ video.filename }}" download="{{ video.filename }}"
               style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; padding: 3px 10px; background: transparent; border: 1px solid rgba(34,211,238,0.3); color: rgba(34,211,238,0.6); cursor: pointer; text-decoration: none; display: inline-block;">DL</a>
            <button onclick="forgeVideoDelete({{ video.id }}, this)"
              style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; padding: 3px 10px; background: transparent; border: 1px solid rgba(234,88,12,0.4); color: var(--reach-orange); cursor: pointer;">DEL</button>
          </div>
        </div>
      </div>
    </div>
    {% else %}
    <p id="forge-video-empty" style="font-family: var(--font-mono); font-size: 0.7rem; color: rgba(34,211,238,0.3); letter-spacing: 0.1em; grid-column: 1 / -1;">NO VIDEOS GENERATED YET.</p>
    {% endfor %}
  </div>

</div>

<!-- Lightbox -->
<div id="forge-lightbox" style="display:none; position:fixed; inset:0; z-index:9000; background:rgba(8,10,18,0.94); backdrop-filter:blur(6px); cursor:zoom-out; align-items:center; justify-content:center; flex-direction:column; gap:16px;">
  <button id="lb-close" onclick="closeLightbox()"
