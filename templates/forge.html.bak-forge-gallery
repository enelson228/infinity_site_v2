    { value: 'portrait-anim', label: 'Portrait Animate — 10stp / CFG 2 / 480×832 / 81f', steps: 10, guidance: 2.0, width: 480, height: 832, length: 81, contextOverlap: 48 },
    { value: 'landscape-anim', label: 'Landscape Animate — 10stp / CFG 2 / 832×480 / 81f', steps: 10, guidance: 2.0, width: 832, height: 480, length: 81, contextOverlap: 48 },
    { value: 'detail-anim', label: 'Detail Animate — 14stp / CFG 2.5 / 480×832 / 81f', steps: 14, guidance: 2.5, width: 480, height: 832, length: 81, contextOverlap: 48 },
  ],
};

document.getElementById('forge-backend')?.addEventListener('change', syncModelSelection);
document.getElementById('forge-model')?.addEventListener('change', syncBackendSelection);

syncModelSelection();

function firstEnabledModel(backend) {
  const options = Array.from(document.getElementById('forge-model')?.options || []);
  const matching = options.find(opt => !opt.disabled && modelConfig[opt.value]?.backend === backend);
  return matching?.value || 'sdxl';
}

function syncModelSelection() {
  const backend = document.getElementById('forge-backend')?.value || 'sdxl';
  const modelSelect = document.getElementById('forge-model');
  if (!modelSelect) return;
  const currentModel = modelSelect.value;
  const currentBackend = modelConfig[currentModel]?.backend;
  if (currentBackend !== backend || modelSelect.selectedOptions[0]?.disabled) {
    modelSelect.value = firstEnabledModel(backend);
  }
  updatePresets();
}

function syncBackendSelection() {
  const model = document.getElementById('forge-model')?.value || 'sdxl';
  const backend = modelConfig[model]?.backend || 'sdxl';
  const backendSelect = document.getElementById('forge-backend');
  if (backendSelect) backendSelect.value = backend;
  updatePresets();
}

function isVideoModel(model) {
  return model === 'wan22-i2v';
}

function updateForgeModeUI() {
  const model = document.getElementById('forge-model')?.value || 'sdxl';
  const isVideo = isVideoModel(model);
  document.getElementById('wan-reference-panel').style.display = isVideo ? 'block' : 'none';
  document.getElementById('wan-lora-panel').style.display = isVideo ? 'block' : 'none';
  const button = document.getElementById('forge-generate-btn');
  if (button) button.textContent = isVideo ? 'GENERATE VIDEO' : 'GENERATE';
}

function updatePresets() {
  const model = document.getElementById('forge-model')?.value || 'sdxl';
  const select = document.getElementById('forge-preset');
  if (!select) return;
  const current = select.value;
  select.innerHTML = '';
  const presets = fullPresets[model] || fullPresets.sdxl;
  presets.forEach(p => {
    const opt = document.createElement('option');
    opt.value = p.value;
    opt.textContent = p.label;
    select.appendChild(opt);
  });
  const match = presets.find(p => p.value === current);
  select.value = match ? current : presets[0].value;
  applyPreset();
}

function applyPreset() {
  const model = document.getElementById('forge-model')?.value || 'sdxl';
  const select = document.getElementById('forge-preset');
  if (!select) return;
  const presets = fullPresets[model] || fullPresets.sdxl;
  const preset = presets.find(p => p.value === select.value);
  if (!preset) return;
  document.getElementById('forge-steps').value = preset.steps;
  document.getElementById('forge-guidance').value = preset.guidance;
  const stepsVal = document.getElementById('steps-val');
  const guidanceVal = document.getElementById('guidance-val');
  if (stepsVal) stepsVal.textContent = preset.steps;
  if (guidanceVal) guidanceVal.textContent = preset.guidance.toFixed(1);
  document.getElementById('forge-width').value = preset.width;
  document.getElementById('forge-height').value = preset.height;
  document.getElementById('wan-video-length').value = preset.length || 81;
  document.getElementById('wan-context-overlap').value = preset.contextOverlap || 48;
  updateForgeModeUI();
}

// Seed helpers
document.getElementById('random-seed-btn')?.addEventListener('click', () => {
  document.getElementById('forge-seed').value = Math.floor(Math.random() * 4294967295);
});
document.getElementById('clear-seed-btn')?.addEventListener('click', () => {
  document.getElementById('forge-seed').value = -1;
});

document.getElementById('wan-reference-upload')?.addEventListener('change', event => {
  const file = event.target.files?.[0];
  if (!file) return;
  document.getElementById('wan-reference-url').value = '';
  document.getElementById('wan-reference-label').textContent = file.name;
  const reader = new FileReader();
  reader.onload = () => {
    const dataUrl = reader.result?.toString() || '';
    document.getElementById('wan-reference-preview').src = dataUrl;
    document.getElementById('wan-reference-preview-shell').style.display = dataUrl ? 'block' : 'none';
  };
  reader.readAsDataURL(file);
});

document.getElementById('wan-clear-reference-btn')?.addEventListener('click', clearWanReference);

function clearWanReference() {
  document.getElementById('wan-reference-upload').value = '';
  document.getElementById('wan-reference-url').value = '';
  document.getElementById('wan-reference-label').textContent = 'NONE SELECTED';
  document.getElementById('wan-reference-preview').src = '';
  document.getElementById('wan-reference-preview-shell').style.display = 'none';
}

function animateImage(imageUrl, prompt='') {
  document.getElementById('forge-backend').value = 'video';
  document.getElementById('forge-model').value = 'wan22-i2v';
  document.getElementById('wan-reference-url').value = imageUrl;
  document.getElementById('wan-reference-label').textContent = 'GALLERY IMAGE SELECTED';
  document.getElementById('wan-reference-preview').src = imageUrl;
  document.getElementById('wan-reference-preview-shell').style.display = 'block';
  updatePresets();
  if (promptEl && !promptEl.value.trim() && prompt) {
    promptEl.value = prompt;
    countEl.textContent = prompt.length;
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// Generate
document.getElementById('forge-generate-btn')?.addEventListener('click', async () => {
  const prompt = promptEl.value.trim();
  const negative = document.getElementById('forge-negative')?.value.trim() || '';
  if (!prompt) { showError('Prompt is required.'); return; }

  const backend = document.getElementById('forge-backend')?.value || 'sdxl';
  const model = document.getElementById('forge-model')?.value || 'sdxl';
  const steps    = parseInt(document.getElementById('forge-steps')?.value || 20);
  const guidance = parseFloat(document.getElementById('forge-guidance')?.value || 7.5);
  const width    = parseInt(document.getElementById('forge-width')?.value || 1024);
  const height   = parseInt(document.getElementById('forge-height')?.value || 1024);
  const seed     = parseInt(document.getElementById('forge-seed')?.value ?? -1);
  const isVideo  = isVideoModel(model);

  setGenerating(true);
  showError('');
  showStatus('SUBMITTING...');

  try {
    let url = '/api/forge/generate';
    let body = { prompt, negative_prompt: negative, steps, guidance_scale: guidance, width, height, seed, worker_type: backend, model };

    if (isVideo) {
      const referenceFile = document.getElementById('wan-reference-upload')?.files?.[0];
      const referenceUrl = document.getElementById('wan-reference-url')?.value || '';
      let imageBase64 = '';
      if (referenceFile) {
        imageBase64 = await readFileAsBase64(referenceFile);
      }
      if (!imageBase64 && !referenceUrl) {
        showError('WAN 2.2 requires a reference image. Upload one or use ANIMATE from the gallery.');
        setGenerating(false);
        showStatus('');
        return;
      }
      let loraPairs = [];
      const loraRaw = document.getElementById('wan-lora-pairs')?.value.trim();
      if (loraRaw) {
        try {
          loraPairs = JSON.parse(loraRaw);
        } catch (e) {
          showError('LoRA pairs must be valid JSON.');
          setGenerating(false);
          showStatus('');
          return;
        }
      }
      url = '/api/forge/videos/generate';
      body = {
        prompt,
        negative_prompt: negative,
        width,
        height,
        length: parseInt(document.getElementById('wan-video-length')?.value || 81),
        steps,
        cfg: guidance,
        context_overlap: parseInt(document.getElementById('wan-context-overlap')?.value || 48),
        seed,
        image_url: referenceUrl,
        image_base64: imageBase64,
        lora_pairs: loraPairs,
      };
    }

    const resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify(body),
    });
    if (resp.status === 401) { showError('Session expired — please reload and log in again.'); setGenerating(false); return; }
    const data = await resp.json();
    if (!resp.ok) { showError(data.error || 'Generation failed.'); setGenerating(false); return; }
    if (isVideo) {
      pollVideoStatus(data.job_id, data.endpoint_id, prompt);
    } else {
      pollStatus(data.job_id, data.endpoint_id, {
        prompt,
        negative,
        model,
        backend,
        steps,
        guidance,
        width,
        height,
        seed,
      });
    }
  } catch (e) {
    showError('Network error. Try again.');
    setGenerating(false);
  }
});

function pollStatus(jobId, endpointId, details) {
  showStatus('QUEUED...');
  let polls = 0;
  const MAX_POLLS = 150;

  async function tick() {
    if (++polls > MAX_POLLS) {
      showError('Generation timed out. The job may still be running on RunPod.');
      showStatus('');
      setGenerating(false);
      return;
    }
    try {
      const prompt = details.prompt || '';
      const url = `/api/forge/status/${jobId}?prompt=${encodeURIComponent(prompt)}&endpoint_id=${encodeURIComponent(endpointId || '')}&worker_type=${encodeURIComponent(details.backend || '')}&model=${encodeURIComponent(details.model || '')}&negative_prompt=${encodeURIComponent(details.negative || '')}&steps=${encodeURIComponent(details.steps ?? '')}&guidance_scale=${encodeURIComponent(details.guidance ?? '')}&width=${encodeURIComponent(details.width ?? '')}&height=${encodeURIComponent(details.height ?? '')}&seed=${encodeURIComponent(details.seed ?? '')}`;
      const resp = await fetch(url);
      const data = await resp.json();

      if (data.status === 'COMPLETED') {
        showStatus('');
        setGenerating(false);
        prependImageCard(data.image_id, data.image_url, details, data.model || details.model, data.worker_type || details.backend);
      } else if (data.status === 'FAILED') {
        showError(data.error || 'Generation failed.');
        showStatus('');
        setGenerating(false);
      } else {
        showStatus(data.status === 'IN_PROGRESS' ? 'GENERATING...' : 'QUEUED...');
        setTimeout(tick, 2000);
      }
    } catch (e) {
      setTimeout(tick, 2000); // transient — keep polling
    }
  }

  setTimeout(tick, 2000);
}

function pollVideoStatus(jobId, endpointId, prompt) {
  showStatus('QUEUED...');
  let polls = 0;
  const maxPolls = 240;

  async function tick() {
    if (++polls > maxPolls) {
      showError('Video generation timed out. The job may still be running on RunPod.');
      showStatus('');
      setGenerating(false);
      return;
    }
    try {
      const url = `/api/forge/videos/status/${jobId}?prompt=${encodeURIComponent(prompt)}&endpoint_id=${encodeURIComponent(endpointId || '')}`;
      const resp = await fetch(url);
      const data = await resp.json();
      if (data.status === 'COMPLETED') {
        showStatus('');
        setGenerating(false);
        prependVideoCard(data.video_id, data.video_url, prompt);
        setTimeout(() => {
          const gallery = document.getElementById('forge-video-gallery');
          if (gallery) {
            gallery.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const newCard = gallery.firstElementChild;
            if (newCard) {
              newCard.style.border = '2px solid var(--reach-cyan)';
              newCard.style.boxShadow = '0 0 20px rgba(34,211,238,0.3)';
              setTimeout(() => {
                newCard.style.border = '1px solid rgba(34,211,238,0.15)';
                newCard.style.boxShadow = 'none';
              }, 3000);
            }
          }
        }, 100);
      } else if (data.status === 'FAILED') {
        showError(data.error || 'Video generation failed.');
        showStatus('');
        setGenerating(false);
      } else {
        showStatus(data.status === 'IN_PROGRESS' ? 'GENERATING...' : 'QUEUED...');
        setTimeout(tick, 4000);
      }
    } catch (e) {
      setTimeout(tick, 4000);
    }
  }

  setTimeout(tick, 4000);
}

function displayModelLabel(model, workerType) {
  if (model) return model;
  if (workerType) return workerType;
  return 'legacy';
}

function prependImageCard(imageId, imageUrl, details, model, workerType) {
  const gallery = document.getElementById('forge-gallery');
  const empty = document.getElementById('forge-empty');
  if (empty) empty.remove();

  const prompt = details.prompt || '';
  const now = new Date().toISOString().slice(0, 16);
  const ep  = escapeHtml(prompt);
  const modelText = displayModelLabel(model, workerType);
  const modelEsc = escapeHtml(modelText);
  const filename = imageUrl.split('/').pop();

  const card = document.createElement('div');
  card.className = 'forge-card';
  card.dataset.id  = imageId;
  card.dataset.url = imageUrl;
  card.dataset.prompt = prompt;
  card.dataset.model = model || '';
  card.dataset.worker = workerType || '';
  card.dataset.negative = details.negative || '';
  card.dataset.steps = details.steps ?? '';
  card.dataset.guidance = details.guidance ?? '';
  card.dataset.width = details.width ?? '';
  card.dataset.height = details.height ?? '';
  card.dataset.seed = details.seed ?? '';
  card.dataset.created = now;
  card.dataset.filename = filename;
  card.style.cssText = 'background:rgba(21,25,42,0.85);border:1px solid rgba(34,211,238,0.15);border-radius:10px;overflow:hidden;';
  card.innerHTML = `
    <div style="position:relative;cursor:zoom-in;" onclick="openLightbox('${imageUrl}')">
      <img src="${imageUrl}" alt="Generated image" style="width:100%;display:block;aspect-ratio:1;object-fit:cover;">
      <span class="forge-model-badge">${modelEsc}</span>
      <div class="forge-zoom-hint">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
      </div>
    </div>
    <div style="padding:10px 12px;">
      <p style="font-family:var(--font-mono);font-size:0.65rem;color:rgba(34,211,238,0.5);margin:0 0 8px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${ep}">${ep}</p>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;">
        <span style="font-family:var(--font-mono);font-size:0.55rem;color:rgba(34,211,238,0.3);flex-shrink:0;">${now}</span>
        <div style="display:flex;gap:6px;align-items:center;">
          <a href="${imageUrl}" download="${filename}"
             style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;padding:3px 10px;background:transparent;border:1px solid rgba(34,211,238,0.3);color:rgba(34,211,238,0.6);cursor:pointer;text-decoration:none;display:inline-block;"
             onmouseover="this.style.background='rgba(34,211,238,0.08)';this.style.color='var(--reach-cyan)'"
             onmouseout="this.style.background='transparent';this.style.color='rgba(34,211,238,0.6)'">DL</a>
          <button onclick="animateImage('${imageUrl}','${ep}')"
            style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;padding:3px 10px;background:transparent;border:1px solid rgba(34,211,238,0.3);color:rgba(34,211,238,0.6);cursor:pointer;"
            onmouseover="this.style.background='rgba(34,211,238,0.08)'" onmouseout="this.style.background='transparent'">ANIMATE</button>
          <button onclick="forgeDelete(${imageId},this)"
            style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;padding:3px 10px;background:transparent;border:1px solid rgba(234,88,12,0.4);color:var(--reach-orange);cursor:pointer;"
            onmouseover="this.style.background='rgba(234,88,12,0.1)'" onmouseout="this.style.background='transparent'">DEL</button>
        </div>
      </div>
    </div>`;
  gallery.prepend(card);
}

function prependVideoCard(videoId, videoUrl, prompt) {
  const gallery = document.getElementById('forge-video-gallery');
  const empty = document.getElementById('forge-video-empty');
  if (empty) empty.remove();
  const now = new Date().toISOString().slice(0, 16);
  const ep = escapeHtml(prompt);
  const filename = videoUrl.split('/').pop();
  const card = document.createElement('div');
  card.className = 'video-card';
  card.dataset.id = videoId;
  card.style.cssText = 'background:rgba(21,25,42,0.85);border:1px solid rgba(34,211,238,0.15);border-radius:10px;overflow:hidden;';
  card.innerHTML = `
    <video src="${videoUrl}" controls preload="metadata" style="width:100%;display:block;aspect-ratio:16/9;background:#000;"></video>
    <div style="padding:10px 12px;">
      <p style="font-family:var(--font-mono);font-size:0.65rem;color:rgba(34,211,238,0.5);margin:0 0 8px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${ep}">${ep}</p>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;">
        <span style="font-family:var(--font-mono);font-size:0.55rem;color:rgba(34,211,238,0.3);flex-shrink:0;">${now}</span>
        <div style="display:flex;gap:6px;align-items:center;">
          <a href="${videoUrl}" download="${filename}" style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;padding:3px 10px;background:transparent;border:1px solid rgba(34,211,238,0.3);color:rgba(34,211,238,0.6);cursor:pointer;text-decoration:none;display:inline-block;">DL</a>
          <button onclick="forgeVideoDelete(${videoId},this)" style="font-family:var(--font-mono);font-size:0.6rem;letter-spacing:0.1em;padding:3px 10px;background:transparent;border:1px solid rgba(234,88,12,0.4);color:var(--reach-orange);cursor:pointer;">DEL</button>
        </div>
      </div>
    </div>`;
  gallery.prepend(card);
}

async function forgeDelete(imageId, btn) {
  btn.disabled = true;
  try {
    const resp = await fetch(`/api/forge/images/${imageId}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': csrfToken },
    });
    if (resp.ok) {
      const card = document.querySelector(`.forge-card[data-id="${imageId}"]`);
      if (card) card.remove();
      if (!document.querySelector('.forge-card')) {
        document.getElementById('forge-gallery').innerHTML =
          '<p id="forge-empty" style="font-family:var(--font-mono);font-size:0.7rem;color:rgba(34,211,238,0.3);letter-spacing:0.1em;grid-column:1/-1;">NO IMAGES GENERATED YET.</p>';
      }
    } else {
      btn.disabled = false;
    }
  } catch (e) {
    btn.disabled = false;
  }
}

async function forgeVideoDelete(videoId, btn) {
  btn.disabled = true;
  try {
    const resp = await fetch(`/api/forge/videos/${videoId}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': csrfToken },
    });
    if (resp.ok) {
      const card = document.querySelector(`.video-card[data-id="${videoId}"]`);
      if (card) card.remove();
      if (!document.querySelector('.video-card')) {
        document.getElementById('forge-video-gallery').innerHTML =
          '<p id="forge-video-empty" style="font-family:var(--font-mono);font-size:0.7rem;color:rgba(34,211,238,0.3);letter-spacing:0.1em;grid-column:1/-1;">NO VIDEOS GENERATED YET.</p>';
      }
    } else {
      btn.disabled = false;
    }
  } catch (e) {
    btn.disabled = false;
  }
}

// Lightbox with gallery navigation
let lbImages = [];
let lbIndex = 0;

function getGalleryImages() {
  const cards = document.querySelectorAll('.forge-card');
  lbImages = Array.from(cards).map(card => ({
    url: card.dataset.url,
    prompt: card.dataset.prompt,
    model: card.dataset.model,
    worker: card.dataset.worker,
    negative: card.dataset.negative,
    steps: card.dataset.steps,
    guidance: card.dataset.guidance,
    width: card.dataset.width,
    height: card.dataset.height,
    seed: card.dataset.seed,
    created: card.dataset.created,
    filename: card.dataset.filename || card.dataset.url.split('/').pop(),
  }));
}

function openLightbox(url) {
  getGalleryImages();
  lbIndex = lbImages.findIndex(img => img.url === url);
  if (lbIndex === -1) lbIndex = 0;
  updateLightboxImage();
  const lb = document.getElementById('forge-lightbox');
  lb.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function updateLightboxImage() {
  const img = lbImages[lbIndex];
  if (!img) return;
  document.getElementById('lb-img').src = img.url;
  document.getElementById('lb-prompt').textContent = img.prompt;
  const negative = document.getElementById('lb-negative');
  if (img.negative) {
    negative.style.display = 'block';
    negative.textContent = `NEGATIVE: ${img.negative}`;
  } else {
    negative.style.display = 'none';
    negative.textContent = '';
  }
  document.getElementById('lb-details').textContent = [
    `MODEL ${displayModelLabel(img.model, img.worker)}`,
    img.worker ? `BACKEND ${img.worker}` : '',
    img.width && img.height ? `SIZE ${img.width}x${img.height}` : '',
    img.steps ? `STEPS ${img.steps}` : '',
    img.guidance ? `CFG ${img.guidance}` : '',
    img.seed !== '' ? `SEED ${img.seed}` : '',
    img.created ? `CREATED ${img.created}` : '',
    img.filename ? `FILE ${img.filename}` : '',
  ].filter(Boolean).join('  //  ');
  const dl = document.getElementById('lb-download');
  dl.href = img.url;
  dl.download = img.url.split('/').pop();
  const counter = document.getElementById('lb-counter');
  counter.textContent = lbImages.length > 1 ? `${lbIndex + 1} / ${lbImages.length}` : '';
  document.getElementById('lb-prev').style.display = lbImages.length > 1 ? 'block' : 'none';
  document.getElementById('lb-next').style.display = lbImages.length > 1 ? 'block' : 'none';
}

function lbPrev() {
  lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length;
  updateLightboxImage();
}

function lbNext() {
  lbIndex = (lbIndex + 1) % lbImages.length;
  updateLightboxImage();
}

function closeLightbox() {
  document.getElementById('forge-lightbox').style.display = 'none';
  document.body.style.overflow = '';
  document.getElementById('lb-img').src = '';
}
document.getElementById('forge-lightbox')?.addEventListener('click', e => {
  if (e.target === document.getElementById('forge-lightbox')) closeLightbox();
});
document.addEventListener('keydown', e => {
  if (document.getElementById('forge-lightbox').style.display === 'flex') {
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lbPrev();
    if (e.key === 'ArrowRight') lbNext();
  }
});

function setGenerating(on) {
  const btn = document.getElementById('forge-generate-btn');
  if (btn) btn.disabled = on;
}
function showStatus(msg) {
  const el = document.getElementById('forge-status');
  if (!el) return;
  el.textContent = msg;
  el.style.display = msg ? 'inline' : 'none';
}
function showError(msg) {
  const el = document.getElementById('forge-error');
  if (!el) return;
  el.textContent = msg;
  el.style.display = msg ? 'block' : 'none';
}
function escapeHtml(str) {
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function readFileAsBase64(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const value = reader.result?.toString() || '';
      resolve(value.includes(',') ? value.split(',', 2)[1] : value);
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}
